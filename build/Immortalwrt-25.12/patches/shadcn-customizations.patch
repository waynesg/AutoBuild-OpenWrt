diff --git a/package/waynesg/luci-theme-shadcn/root/etc/uci-defaults/31_luci-theme-shadcn-background b/package/waynesg/luci-theme-shadcn/root/etc/uci-defaults/31_luci-theme-shadcn-background
new file mode 100755
index 0000000..1253df0
--- /dev/null
+++ b/package/waynesg/luci-theme-shadcn/root/etc/uci-defaults/31_luci-theme-shadcn-background
@@ -0,0 +1,12 @@
+#!/bin/sh
+
+SCRIPT=/usr/bin/shadcn-login-bg
+CRON='17 3 * * * /usr/bin/shadcn-login-bg'
+
+chmod 0755 "$SCRIPT"
+mkdir -p /www/luci-static/shadcn/images
+grep -Fqx "$CRON" /etc/crontabs/root 2>/dev/null || echo "$CRON" >> /etc/crontabs/root
+/etc/init.d/cron enable 2>/dev/null || true
+/etc/init.d/cron restart 2>/dev/null || true
+
+exit 0
diff --git a/package/waynesg/luci-theme-shadcn/root/usr/bin/shadcn-login-bg b/package/waynesg/luci-theme-shadcn/root/usr/bin/shadcn-login-bg
new file mode 100755
index 0000000..a7d26a0
--- /dev/null
+++ b/package/waynesg/luci-theme-shadcn/root/usr/bin/shadcn-login-bg
@@ -0,0 +1,28 @@
+#!/bin/sh
+
+DEST=/www/luci-static/shadcn/images/login-bg.jpeg
+FALLBACK=/www/luci-static/shadcn/images/login-bg-fallback.jpeg
+TMP=/tmp/shadcn-login-bg.jpeg
+DAY=$(date +%j)
+
+case $((DAY % 7)) in
+	0) URL='https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=1600&q=85&auto=format' ;;
+	1) URL='https://images.unsplash.com/photo-1473448912268-2022ce9509d8?w=1600&q=85&auto=format' ;;
+	2) URL='https://images.unsplash.com/photo-1500534623283-312aadd485b7?w=1600&q=85&auto=format' ;;
+	3) URL='https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1600&q=85&auto=format' ;;
+	4) URL='https://images.unsplash.com/photo-1501854140801-50d01698950b?w=1600&q=85&auto=format' ;;
+	5) URL='https://images.unsplash.com/photo-1511497584788-876760111969?w=1600&q=85&auto=format' ;;
+	*) URL='https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=1600&q=85&auto=format' ;;
+esac
+
+mkdir -p "$(dirname "$DEST")"
+test -s "$FALLBACK" || cp "$DEST" "$FALLBACK" 2>/dev/null || true
+rm -f "$TMP"
+
+if curl -L --fail --silent --max-time 45 "$URL" -o "$TMP" && test -s "$TMP"; then
+	mv "$TMP" "$DEST"
+	chmod 0644 "$DEST"
+else
+	rm -f "$TMP"
+	test -s "$FALLBACK" && cp "$FALLBACK" "$DEST"
+fi
