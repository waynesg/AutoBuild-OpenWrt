#!/bin/sh /etc/rc.common

START=75
STOP=15
USE_PROCD=1

start_service() {
	config_load cups-web
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get listen_addr main listen_addr '0.0.0.0:8080'
	config_get cups_host main cups_host '127.0.0.1'
	config_get data_dir main data_dir '/etc/cups-web'
	config_get upload_dir main upload_dir '/etc/cups-web/uploads'
	config_get_bool cookie_secure main cookie_secure 0
	mkdir -p "$data_dir" "$upload_dir"

	procd_open_instance
	procd_set_param command /usr/bin/cups-web
	procd_set_param env LISTEN_ADDR="$listen_addr" CUPS_HOST="$cups_host" \
		DB_PATH="$data_dir/cups-web.db" UPLOAD_DIR="$upload_dir" \
		COOKIE_SECURE="$cookie_secure"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile='8192 8192'
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cups-web
}
