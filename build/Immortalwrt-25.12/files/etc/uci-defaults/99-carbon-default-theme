#!/bin/sh
# Make Carbon the default theme. The static assets (fonts + device icons)
# are shipped under files/www/luci-static/carbon/ and override the package.

if [ -d /www/luci-static/carbon ]; then
	uci -q set luci.themes.Carbon='/luci-static/carbon'
	uci -q set luci.main.mediaurlbase='/luci-static/carbon'
	uci -q set luci.main.lang='zh_cn'
	uci -q commit luci
fi

# Remove the previous theme's scheduled background job on retained configs.
if [ -f /etc/crontabs/root ]; then
	sed -i '\|/usr/bin/shadcn-login-bg|d' /etc/crontabs/root
fi

exit 0
