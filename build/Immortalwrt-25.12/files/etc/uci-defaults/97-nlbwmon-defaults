#!/bin/sh

set_sysctl() {
	local key="$1"
	local value="$2"
	local file="/etc/sysctl.conf"

	sysctl -w "${key}=${value}" >/dev/null 2>&1 || true

	if grep -q "^${key}=" "$file" 2>/dev/null; then
		sed -i "s/^${key}=.*/${key}=${value}/" "$file"
	else
		echo "${key}=${value}" >> "$file"
	fi
}

set_sysctl net.core.rmem_max 1048576
set_sysctl net.core.rmem_default 262144
set_sysctl net.netfilter.nf_conntrack_acct 1
set_sysctl net.netfilter.nf_conntrack_events 1

echo Y > /sys/module/nf_conntrack/parameters/acct 2>/dev/null || true

if uci -q get nlbwmon.@nlbwmon[0] >/dev/null; then
	uci set nlbwmon.@nlbwmon[0].netlink_buffer_size='1048576'
	uci set nlbwmon.@nlbwmon[0].commit_interval='10m'
	uci set nlbwmon.@nlbwmon[0].refresh_interval='30s'
	uci delete nlbwmon.@nlbwmon[0].local_network 2>/dev/null || true
	uci add_list nlbwmon.@nlbwmon[0].local_network='192.168.10.0/24'
	uci commit nlbwmon
	/etc/init.d/nlbwmon enable >/dev/null 2>&1 || true
fi

exit 0
